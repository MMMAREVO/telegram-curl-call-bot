BOT_TOKEN=123456:ABC-your-telegram-bot-token
# Пароль, который бот спрашивает у новых пользователей перед регистрацией (обязателен)
BOT_ACCESS_PASSWORD=
CAMPAIGNS_API_BASE=http://<campaigns-api-host>:8080
EXCEL_PATH=bot_data.xlsx
# Telegram ID администраторов через запятую — им доступна выгрузка данных всех исполнителей
ADMIN_TELEGRAM_IDS=

# PostgreSQL с транскрипцией
PG_HOST=
PG_PORT=5432
PG_DB=
PG_USER=
PG_PASSWORD=
PG_TABLE=
PG_TEXT_COLUMN=transcribation

# SSH — источник логов №1: ЛАБА (iba-app)
SSH_HOST=
SSH_PORT=22
SSH_USER=
SSH_KEY_PATH=
SSH_PASSWORD=
SSH_SUDO_PASSWORD=
K8S_NAMESPACE=iba
K8S_POD=iba-app-0

# SSH — источник логов №2: CPAAS (cpaas-studio). Если пусто — берётся логин/ключ из SSH_*.
SSH2_HOST=
SSH2_PORT=22
SSH2_USER=
SSH2_KEY_PATH=
SSH2_PASSWORD=
SSH2_SUDO_PASSWORD=
K8S_NAMESPACE_2=cpaas
K8S_POD_2=cpaas-studio-0

KUBECTL_BIN=kubectl

# Опрос БД: как часто проверять и сколько максимум ждать завершения звонка / транскрипции
CALL_POLL_INTERVAL=3
CALL_COMPLETION_TIMEOUT=240
TRANSCRIPT_TIMEOUT=120
PROGRESS_PING_SECONDS=30
LOG_FETCH_BUFFER_SECONDS=15

# VictoriaLogs — общее хранилище логов CPAAS (asr-orch, sfas, sengine...). Пусто — не собирать
VLOGS_URL=
VLOGS_WINDOW_PADDING_SECONDS=60

# Жёсткий потолок на обработку одного звонка целиком (звонок физически не может идти дольше)
MAX_CALL_SESSION_SECONDS=900
